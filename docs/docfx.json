{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../src",
          "files": [ "SimdUnicode.csproj" ]
        }
      ],
      "dest": "api",
      "namespaceLayout": "flattened",
      "memberLayout": "separatePages",
      "enumSortOrder": "declaringOrder",
      "properties": {
        "TargetFramework": "net10.0"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": [ "api/**.yml", "api/index.md" ]
      },
      {
        "files": [ "articles/**.md", "articles/**/toc.yml", "toc.yml", "*.md" ],
        "exclude": [ "README.md" ]
      }
    ],
    "resource": [
      {
        "files": [ "assets/**", "logo.svg" ]
      }
    ],
    "output": "_site",
    "template": [ "default", "modern", "template" ],
    "globalMetadata": {
      "_appName": "SimdUnicode",
      "_appTitle": "SimdUnicode — fast UTF-8 validation for .NET",
      "_appFooter": "SimdUnicode &copy; 2024-2026 &middot; Released under the Apache 2.0 License",
      "_appLogoPath": "logo.svg",
      "_appFaviconPath": "logo.svg",
      "_enableSearch": true,
      "_gitContribute": {
        "repo": "https://github.com/simdutf/SimdUnicode",
        "branch": "main"
      },
      "pdf": false
    },
    "globalMetadataFiles": [],
    "fileMetadata": {},
    "postProcessors": [ "ExtractSearchIndex" ],
    "keepFileLink": false,
    "disableGitFeatures": false
  }
}
